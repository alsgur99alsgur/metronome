{
  "name": "metronome",
  "private": true,
  "version": "0.0.0",
  "description": "Metronome desktop application",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:win": "npm run build && node run-electron-builder.cjs --win zip",
    "pack:win": "npm run build && node run-electron-builder.cjs --win --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.metronome.desktop",
    "productName": "Metronome",
    "directories": {
      "output": "release"
    },
    "afterPack": "electron/after-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../backend/dist/metronome_backend",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../admin-frontend/dist",
        "to": "admin-dist"
      }
    ],
    "win": {
      "executableName": "electron",
      "artifactName": "Metronome-${version}-win-${arch}.${ext}",
      "target": [
        "zip"
      ]
    }
  }
}
